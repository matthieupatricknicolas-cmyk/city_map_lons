{
  "project_name": "Cartographie Intelligente Lons-le-Saunier 3D",
  "archetype": "THE PERFORMANCE SWISS & GEOSPATIAL EDITORIAL",
  "context": "Interactive MapLibre 3D cartographic dashboard for Ville de Lons-le-Saunier with live Overpass API integration, themes (Mobilité & Commerces), and sliding detail sidebar.",
  "theme_strategy": "Light mode primary with dark map aesthetic options. Premium municipal authority combined with high-performance cartography (Citymapper / Mapbox / Komoot feel).",
  "colors": {
    "primary": {
      "main": "#003D7A",
      "hover": "#002855",
      "light": "#E8F1FB",
      "description": "Bleu institutionnel Lons-le-Saunier - Deep Blue for primary structural elements, active tab rail, and header highlights."
    },
    "secondary": {
      "main": "#E30613",
      "hover": "#B8000B",
      "light": "#FDE8E9",
      "description": "Rouge dynamique Lons-le-Saunier - Vibrant Red accent for active POIs, CTA badges, and real-time indicators."
    },
    "mobility_theme": {
      "bike_parking": "#059669",
      "cycle_lanes": "#10B981",
      "bus_shelter": "#2563EB",
      "bus_lines": "#3B82F6",
      "accent": "#0D9488"
    },
    "commerces_theme": {
      "food_groceries": "#D97706",
      "fashion_retail": "#8B5CF6",
      "dining_cafes": "#EC4899",
      "services": "#0284C7",
      "accent": "#F59E0B"
    },
    "neutrals": {
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "surface_elevated": "rgba(255, 255, 255, 0.88)",
      "border": "#E2E8F0",
      "border_focus": "#003D7A",
      "text_main": "#0F172A",
      "text_muted": "#64748B",
      "map_overlay_bg": "rgba(255, 255, 255, 0.92)"
    },
    "map_3d_extrusion": {
      "building_color": "#E2E8F0",
      "building_active_color": "#003D7A",
      "building_opacity": 0.85
    }
  },
  "typography": {
    "heading_font": "Cabinet Grotesk, Plus Jakarta Sans, sans-serif",
    "body_font": "Plus Jakarta Sans, system-ui, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "scale": {
      "app_title": "text-xl sm:text-2xl font-black tracking-tight",
      "section_header": "text-lg sm:text-xl font-bold tracking-tight",
      "poi_title": "text-2xl font-extrabold tracking-tight text-slate-900",
      "card_title": "text-base font-bold text-slate-800",
      "body_text": "text-sm text-slate-600 leading-relaxed",
      "badge_text": "text-xs font-semibold uppercase tracking-wider",
      "coord_label": "font-mono text-xs text-slate-500"
    }
  },
  "spacing_and_layout": {
    "sidebar_width": "w-20 md:w-64",
    "detail_panel_width": "w-full sm:w-96 md:w-[420px]",
    "header_height": "h-16",
    "map_container": "h-[calc(100vh-4rem)] relative overflow-hidden",
    "padding": {
      "card": "p-5",
      "panel": "p-6",
      "tab_item": "px-4 py-3"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-md bg-white/90 border border-white/40 shadow-xl",
    "panel_shadow": "shadow-[0_20px_50px_rgba(8,112,184,0.12)]",
    "map_controls_shadow": "shadow-lg shadow-slate-900/5",
    "hover_lift": "transition-transform duration-200 hover:-translate-y-0.5",
    "badge_glow": "shadow-[0_0_12px_rgba(227,6,19,0.3)]"
  },
  "maplibre_configuration": {
    "default_center": [5.5539, 46.6739],
    "default_zoom": 15,
    "default_pitch": 45,
    "default_bearing": -17.6,
    "basemaps": [
      {
        "id": "openfreemap",
        "name": "OpenFreeMap (Liberty)",
        "url": "https://tiles.openfreemap.org/styles/liberty",
        "type": "vector"
      },
      {
        "id": "cartodb_voyager",
        "name": "CARTO Voyager (Clair)",
        "url": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "type": "vector"
      },
      {
        "id": "ign_ortho",
        "name": "IGN Orthophoto (Satellite)",
        "type": "raster",
        "tiles": ["https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=ORTHOIMAGERY.ORTHOPHOTOS&STYLE=normal&FORMAT=image/jpeg&TILEMATRIXSET=PM&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}"]
      },
      {
        "id": "osm_fr",
        "name": "OpenStreetMap France",
        "type": "raster",
        "tiles": ["https://a.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png"]
      },
      {
        "id": "opentopomap",
        "name": "OpenTopoMap (Relief)",
        "type": "raster",
        "tiles": ["https://a.tile.opentopomap.org/{z}/{x}/{y}.png"]
      },
      {
        "id": "maplibre_demotiles",
        "name": "MapLibre Vector Demo",
        "url": "https://demotiles.maplibre.org/style.json",
        "type": "vector"
      },
      {
        "id": "jawg_streets",
        "name": "CARTO Dark Matter (Mode Nuit)",
        "url": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        "type": "vector"
      }
    ],
    "overpass_queries": {
      "mobility": {
        "bike_parking": "[out:json][timeout:25];node[\"amenity\"=\"bicycle_parking\"](around:3000,46.6739,5.5539);out body;>;out skel qt;",
        "cycle_lanes": "[out:json][timeout:25];way[\"highway\"=\"cycleway\"](around:3000,46.6739,5.5539);out body;>;out skel qt;",
        "bus_shelter": "[out:json][timeout:25];node[\"highway\"=\"bus_stop\"](around:3000,46.6739,5.5539);out body;>;out skel qt;",
        "bus_lines": "[out:json][timeout:25];relation[\"route\"=\"bus\"](around:3000,46.6739,5.5539);out body;>;out skel qt;"
      },
      "commerces": {
        "shops": "[out:json][timeout:25];(node[\"shop\"](around:3000,46.6739,5.5539);way[\"shop\"](around:3000,46.6739,5.5539);node[\"amenity\"~\"restaurant|cafe|fast_food|bar\"](around:3000,46.6739,5.5539););out body;>;out skel qt;"
      }
    }
  },
  "iconography_rules": {
    "library": "lucide-react",
    "flaticon_style_mapping": {
      "bike_parking": "Bike",
      "cycle_lanes": "Navigation",
      "bus_shelter": "Bus",
      "bus_lines": "Route",
      "food_groceries": "ShoppingBag",
      "dining_cafes": "Utensils",
      "fashion_retail": "Shirt",
      "services": "Store",
      "3d_toggle": "Box",
      "basemap_switcher": "Layers",
      "locate": "Crosshair",
      "filter": "Filter",
      "info": "Info",
      "close": "X"
    }
  },
  "image_urls": {
    "lons_street_historic": "https://images.unsplash.com/photo-1775831554108-2d1232729cf5?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDN8MHwxfHNlYXJjaHwzfHxGcmVuY2glMjB0b3duJTIwaGlzdG9yaWMlMjBzdHJlZXQlMjBldXJvcGV8ZW58MHx8fHwxNzg4MzM1NzQxfDA&ixlib=rb-4.1.0&q=85",
    "lons_place_liberte": "https://images.unsplash.com/photo-1762854915084-e1a6c91fda57?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDN8MHwxfHNlYXJjaHwyfHxGcmVuY2glMjB0b3duJTIwaGlzdG9yaWMlMjBzdHJlZXQlMjBldXJvcGV8ZW58MHx8fHwxNzg4MzM1NzQxfDA&ixlib=rb-4.1.0&q=85",
    "lons_arcade_street": "https://images.unsplash.com/photo-1759770663471-3f7d71096f39?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2NDN8MHwxfHNlYXJjaHw0fHxGcmVuY2glMjB0b3duJTIwaGlzdG9yaWMlMjBzdHJlZXQlMjBldXJvcGV8ZW58MHx8fHwxNzg4MzM1NzQxfDA&ixlib=rb-4.1.0&q=85"
  },
  "testing_and_data_ids": {
    "rule": "Every interactive and dynamic element MUST have a clear data-testid attribute in kebab-case format.",
    "required_test_ids": [
      "app-header",
      "app-logo-lons",
      "tab-mobility-button",
      "tab-commerces-button",
      "basemap-selector-dropdown",
      "3d-buildings-toggle",
      "layer-bike-parking-checkbox",
      "layer-cycle-lanes-checkbox",
      "layer-bus-shelter-checkbox",
      "layer-bus-lines-checkbox",
      "layer-commerces-checkbox",
      "map-container",
      "map-loading-spinner",
      "side-detail-panel",
      "side-detail-panel-close",
      "poi-title",
      "poi-category-badge",
      "poi-details-container",
      "map-reset-camera-button"
    ]
  },
  "instructions_to_main_agent": [
    "Install maplibre-gl and lucide-react if needed, ensure maplibre-gl CSS is imported in index.js or App.js.",
    "Construct the map instance centered at [5.5539, 46.6739] with zoom 15, pitch 45.",
    "Support dynamic Overpass API fetching with loading indicators and error fallbacks/cached fallback data for high reliability.",
    "Implement the vertical tab rail on the left for switching themes (Mobilité vs Commerces) with badge counts.",
    "Implement the sliding side detail card from the right when clicking a map marker, and close it when clicking empty map space.",
    "Add 3D building extrusion layer using MapLibre fill-extrusion with pitch control toggle.",
    "Add top control bar with Lons-le-Saunier municipal branding (#003D7A primary, #E30613 accent) and basemap switcher.",
    "Ensure all data-testid attributes specified are present in the final React components."
  ]
}